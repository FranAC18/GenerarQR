# ============================================================================
# QR DIGITAL STUDIO - VARIABLES DE ENTORNO
# ============================================================================
# Copia este archivo a .env para desarrollo local o agrégalas en el panel de Vercel:
# Project Settings -> Environment Variables

# URL del proyecto Supabase (ej: https://your-project-id.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Clave pública de Supabase (anon key o service_role key)
SUPABASE_KEY=your-supabase-anon-or-service-key

# URL base del despliegue (opcional, para generar los enlaces de redirección dinámicos /c/{id})
BASE_URL=https://generar-qr.vercel.app
