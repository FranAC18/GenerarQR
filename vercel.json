{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "static/**",
      "use": "@vercel/static"
    },
    {
      "src": "img/**",
      "use": "@vercel/static"
    }
  ],
  "proxy": {
    "entrypoint": "middleware.js",
    "matcher": "/(.*)"
  },
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/c/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "/static/$1",
      "headers": {
        "Access-Control-Allow-Origin": "https://qr-kobaia.vercel.app"
      }
    },
    {
      "src": "/img/(.*)",
      "dest": "/img/$1",
      "headers": {
        "Access-Control-Allow-Origin": "https://qr-kobaia.vercel.app"
      }
    },
    {
      "src": "/(.*)",
      "dest": "/static/index.html",
      "headers": {
        "Access-Control-Allow-Origin": "https://qr-kobaia.vercel.app"
      }
    }
  ]
}
